# ============================================================
# Work Management AI - Enterprise Self-host
# ============================================================

NODE_ENV=production
PORT=3001
WEB_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
COOKIE_SECURE=false

# Frontend build-time values for non-Docker builds. Compose uses same-origin URLs.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SOCKET_URL=

# PostgreSQL
POSTGRES_DB=work_ai
POSTGRES_USER=work_ai
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgresql://work_ai:change_this_postgres_password@postgres:5432/work_ai?schema=public
# Optional external database override for Docker only:
# DOCKER_DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# Redis / BullMQ
REDIS_URL=redis://redis:6379
AI_WORKER_CONCURRENCY=2
AI_ENABLED=true
AI_AUTO_APPLY=false
TIMEZONE=Asia/Ho_Chi_Minh

# Session
SESSION_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_application_credentials.json
# Host ADC file mounted read-only by docker-compose.override.yml.
# Windows: C:/Users/<user>/AppData/Roaming/gcloud/application_default_credentials.json
# Mac/Linux: /home/<user>/.config/gcloud/application_default_credentials.json
GOOGLE_ADC_HOST_PATH=/absolute/path/to/application_default_credentials.json

# Reverse proxy
PUBLIC_HTTP_PORT=8080
# Optional HTTPS profile: docker-compose.https.yml (hostname only)
# PUBLIC_DOMAIN=work.example.com
