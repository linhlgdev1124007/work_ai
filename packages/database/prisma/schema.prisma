datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. TỔ CHỨC & NGƯỜI DÙNG
model Organization {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  settings    String?  // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                 User[]
  teams                 Team[]
  projects              Project[]
  conversations         Conversation[]
  tasks                 Task[]
  attendanceSessions    AttendanceSession[]
  attendanceAdjustments AttendanceAdjustment[]
  aiRuns                AiRun[]
  aiTokenUsage          AiTokenUsage[]
  aiActions             AiAction[]
  auditEvents           AuditEvent[]
  notifications         Notification[]
}

model User {
  id                 String   @id @default(uuid())
  orgId              String
  email              String   @unique
  passwordHash       String
  fullName           String
  avatarUrl          String?
  systemRole         String   @default("MEMBER") // ADMIN, MEMBER
  status             String   @default("ACTIVE") // ACTIVE, SUSPENDED
  mustChangePassword Boolean  @default(false)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]
  sentMessages       Message[]
  conversationMemberships ConversationMember[]
  assignedTasks      Task[]       @relation("TaskAssignee")
  createdTasks       Task[]       @relation("TaskCreator")
  taskEvents         TaskEvent[]
  currentWork        CurrentWork?
  workStatusEvents   WorkStatusEvent[]
  attendanceSessions AttendanceSession[]
  attendanceAdjustments AttendanceAdjustment[] @relation("UserAdjustments")
  approvedAdjustments   AttendanceAdjustment[] @relation("ApproverAdjustments")
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  notificationPreferences NotificationPreference?
  initiatedAiActions AiAction[]   @relation("AiActionInitiator")
}

model Team {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  projects     Project[]
  tasks        Task[]
  conversations Conversation[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER") // LEAD, MEMBER
  joinedAt  DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Project {
  id          String   @id @default(uuid())
  teamId      String
  orgId       String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]
  conversations Conversation[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  joinedAt  DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// 2. PHIÊN ĐĂNG NHẬP & BẢO MẬT
model Session {
  pushSubscriptions PushSubscription[]
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 3. HỘI THOẠI & CHAT
model Conversation {
  id            String   @id @default(uuid())
  orgId         String
  type          String   // TEAM, PROJECT, DIRECT, GROUP
  name          String
  teamId        String?
  projectId     String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team          Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members       ConversationMember[]
  messages      Message[]
  aiActions     AiAction[]
  readMarkers   ReadMarker[]
  tasks         Task[]
}

model ConversationMember {
  id                 String    @id @default(uuid())
  conversationId     String
  userId             String
  role               String    @default("MEMBER") // ADMIN, MEMBER
  joinedAt           DateTime  @default(now())
  lastReadMessageId  String?
  unreadCount        Int       @default(0)

  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  assistantReply   String?
  kind             String @default("CHAT")
  mentionIds       String[] @default([])
  id               String   @id @default(uuid())
  conversationId   String
  senderId         String
  replyToId        String?
  content          String
  isDeleted        Boolean  @default(false)
  clientMessageId  String   @unique
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo          Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies          Message[]    @relation("MessageReplies")
  revisions        MessageRevision[]
  attachments      MessageAttachment[]
  aiRuns           AiRun[]
  aiActions        AiAction[]
  tasksCreated     Task[]       @relation("TaskSourceMessage")
  @@index([conversationId, createdAt, id])
}

model MessageRevision {
  id         String   @id @default(uuid())
  messageId  String
  oldContent String
  editedBy   String
  createdAt  DateTime @default(now())

  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model ReadMarker {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  lastReadId     String
  updatedAt      DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

// 4. QUẢN LÝ TASK & TIẾN ĐỘ
model Task {
  id                 String    @id @default(uuid())
  orgId              String
  teamId             String?
  projectId          String?
  parentId           String?
  title              String
  description        String?
  assigneeId         String?
  creatorId          String
  priority           String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status             String    @default("TODO")   // TODO, IN_PROGRESS, WAITING, REVIEW, COMPLETED, PAUSED
  startDate          DateTime?
  deadline           DateTime?
  completionDeadline DateTime?
  completedAt        DateTime?
  estimateMinutes    Int?
  requiresReview     Boolean   @default(false)
  reviewerId         String?
  sourceMessageId    String?
  sourceConversationId String?
  isArchived         Boolean   @default(false)
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team               Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project            Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent             Task?        @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks           Task[]       @relation("TaskHierarchy")
  assignee           User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator            User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  sourceMessage      Message?     @relation("TaskSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  sourceConversation Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  checklistItems     TaskChecklistItem[]
  events             TaskEvent[]
  attachments        TaskAttachment[]
  dependencies       TaskDependency[] @relation("TaskDependencies")
  dependentOn        TaskDependency[] @relation("TaskDependentOn")
  currentWorks       CurrentWork[]
  reminderDeliveries ReminderDelivery[]
  @@index([sourceConversationId])
}

model TaskChecklistItem {
  id            String    @id @default(uuid())
  taskId        String
  title         String
  isCompleted   Boolean   @default(false)
  position      Int       @default(0)
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String   // Task bị phụ thuộc
  dependsOnTaskId String   // Task điều kiện tiên quyết
  createdAt       DateTime @default(now())

  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskDependentOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model TaskEvent {
  id           String   @id @default(uuid())
  taskId       String
  actorId      String
  actionType   String
  fieldChanged String?
  oldValue     String?
  newValue     String?
  metadata     String?  // JSON string
  createdAt    DateTime @default(now())

  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

// 5. ĐANG LÀM GÌ (CURRENT WORK)
model CurrentWork {
  id               String   @id @default(uuid())
  userId           String   @unique
  taskId           String?
  customStatusText String?
  startedAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task             Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model WorkStatusEvent {
  id         String   @id @default(uuid())
  userId     String
  taskId     String?
  statusText String?
  action     String   // START, SWITCH, STOP
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 6. ĐIỂM DANH (ATTENDANCE)
model AttendanceSession {
  id           String    @id @default(uuid())
  orgId        String
  userId       String
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  status       String    @default("OPEN") // OPEN, CLOSED
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AttendanceAdjustment {
  id                String    @id @default(uuid())
  orgId             String
  userId            String
  sessionId         String?
  type              String    // NEW_SESSION, EDIT_SESSION
  requestedCheckIn  DateTime
  requestedCheckOut DateTime
  reason            String
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approverId        String?
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user              User         @relation("UserAdjustments", fields: [userId], references: [id], onDelete: Cascade)
  approver          User?        @relation("ApproverAdjustments", fields: [approverId], references: [id], onDelete: SetNull)
}

// 7. FILE & ATTACHMENTS
model Attachment {
  id          String   @id @default(uuid())
  orgId       String
  uploaderId  String
  fileName    String
  fileSize    Int
  mimeType    String
  storageKey  String   @unique
  createdAt   DateTime @default(now())

  messageAttachments MessageAttachment[]
  taskAttachments    TaskAttachment[]
}

model MessageAttachment {
  id           String     @id @default(uuid())
  messageId    String
  attachmentId String

  message      Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([messageId, attachmentId])
}

model TaskAttachment {
  id           String     @id @default(uuid())
  taskId       String
  attachmentId String

  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([taskId, attachmentId])
}

// 8. VERTEX AI & ACTIONS
model AiTokenUsage {
  id                String @id @default(uuid())
  orgId             String
  model             String
  inputTokens       Int
  cachedInputTokens Int
  outputTokens      Int
  createdAt         DateTime @default(now())
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model AiRun {
  id                String   @id @default(uuid())
  orgId             String
  conversationId    String
  triggerMessageId  String
  modelName         String
  promptTokens      Int?
  completionTokens  Int?
  latencyMs         Int?
  rawResponse       String?
  status            String   // SUCCESS, FAILED
  errorMessage      String?
  createdAt         DateTime @default(now())

  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  triggerMessage    Message      @relation(fields: [triggerMessageId], references: [id], onDelete: Cascade)
  actions           AiAction[]
}

model AiAction {
  id               String    @id @default(uuid())
  aiRunId          String
  orgId            String
  conversationId   String
  sourceMessageId  String
  initiatorId      String
  intent           String    // CREATE_TASK, UPDATE_ASSIGNEE, UPDATE_DEADLINE, UPDATE_STATUS, etc.
  targetEntityType String    // TASK, CURRENT_WORK
  targetEntityId   String?
  expectedVersion  Int       @default(1)
  patchPayload     String    // JSON string
  evidenceText     String
  confidence       Float
  status           String    @default("PENDING_CONFIRMATION") // AUTO_APPLIED, PENDING_CONFIRMATION, CONFIRMED, CANCELLED, UNDONE, EXPIRED
  expiresAt        DateTime?
  appliedAt        DateTime?
  undoneAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  aiRun            AiRun        @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage    Message      @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  initiator        User         @relation("AiActionInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
}

// 9. THÔNG BÁO & NHẮC NHỞ
model Notification {
  pushAcceptedSubscriptionIds String[] @default([])
  eventKey    String?  @unique
  pushProcessedAt DateTime?
  pushAttempts Int @default(0)
  pushNextAt DateTime @default(now())
  id          String   @id @default(uuid())
  orgId       String
  userId      String
  type        String   // TASK_ASSIGNED, TASK_REMINDER, AI_ACTION_PROPOSED, ATTENDANCE_ALERT, SYSTEM
  title       String
  body        String
  entityType  String?
  entityId    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([pushProcessedAt, pushNextAt])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  enableWebPush    Boolean  @default(true)
  enableInApp      Boolean  @default(true)
  quietHoursStart  String   @default("20:00")
  quietHoursEnd    String   @default("08:00")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  sessionId String?
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dhKey String
  authKey   String
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReminderDelivery {
  id              String   @id @default(uuid())
  taskId          String
  reminderType    String   // DUE_SOON_2H, OVERDUE_ONCE, WAITING_STALE_2D, INACTIVE_STALE_2D
  deadlineVersion Int      @default(1)
  sentAt          DateTime @default(now())

  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, reminderType, deadlineVersion])
}

// 10. HẠ TẦNG & KIỂM TOÁN
model AuditEvent {
  id         String   @id @default(uuid())
  orgId      String
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   String?  // JSON string
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model OutboxEvent {
  id         String   @id @default(uuid())
  eventType  String
  payload    String   // JSON string
  status     String   @default("PENDING") // PENDING, PROCESSED, FAILED
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())
}
